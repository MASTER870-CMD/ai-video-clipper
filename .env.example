# ==============================================================================
# AI Video Clipper - Environment Configuration Template
# Copy this file to .env and configure your API keys.
# DO NOT commit your actual .env file to version control.
# ==============================================================================

# Google Gemini API Configuration (Default & Recommended)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# Anthropic Claude API Configuration (Alternative High-Precision Semantic Selector)
# Obtain from: https://console.anthropic.com/
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Faster-Whisper ASR Model Configuration
# Options: tiny, base, small, medium, large-v3
# Recommended: "base" for optimal speed/accuracy trade-off, "small" for enhanced accuracy
WHISPER_MODEL=base
